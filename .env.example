REC_MODE=demo
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=yingke
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-local-mysql-password
# Used only by containers, not the host Python service.
MYSQL_DOCKER_HOST=host.docker.internal
# Lifetime of a login session; users must sign in again after it expires.
AUTH_TOKEN_TTL_DAYS=30
SEED_CATALOG=1
SEED_ANALYTICS=1
MODEL_DIRECTORY=runtime/models
MEDIA_DIRECTORY=runtime/media

KAFKA_BOOTSTRAP_SERVERS=master:9092
KAFKA_TOPIC=rec-events
FLINK_REST_URL=http://master:8081
FLINK_HOME=/usr/local/soft/flink-1.18.1
FLINK_PYTHON=/usr/bin/python3
# Filled automatically by scripts.stream submit
FLINK_JOB_ID=
